# Runtime environment
NODE_ENV=development
PORT=8787

# Required in production. Generate a long random secret; never use change-me.
JWT_SECRET=replace-with-a-long-random-secret

# Optional when frontend and API share the same origin. For local separate Vite/API dev, use: http://localhost:5173
CORS_ORIGIN=

# Optional AI configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional administrator bootstrap. If ADMIN_EMAIL is set, ADMIN_PASSWORD is required.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Administrator

# Optional auth throttling: 5-1000 attempts per 15 minutes per client.
AUTH_RATE_LIMIT=30

